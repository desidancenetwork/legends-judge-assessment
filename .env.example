# Copy to .env.local for local development. Everything is optional locally:
# without Redis, settings are kept in memory; without Google credentials,
# submissions are written to .local-submissions/ instead of Google Drive.
# In production (Vercel) all of these must be set except where noted.

# Admin login at /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# NextAuth: a long random secret (e.g. `openssl rand -base64 32`) and the site's public URL.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Upstash Redis for admin settings. Added automatically when an Upstash store is
# connected to the Vercel project (KV_REST_API_READ_ONLY_TOKEN and KV_URL are also added but unused).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google service account that writes submissions to Drive. Copy these from the
# service account's JSON key file (private_key may keep its \n escapes).
GOOGLE_CREDENTIALS_CLIENT_EMAIL=
GOOGLE_CREDENTIALS_PRIVATE_KEY=
GOOGLE_CREDENTIALS_PRIVATE_KEY_ID=
GOOGLE_CREDENTIALS_PROJECT_ID=
GOOGLE_CREDENTIALS_CLIENT_ID=
